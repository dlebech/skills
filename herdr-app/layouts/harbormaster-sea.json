{
  "id": "hs-root",
  "type": "column",
  "preview": "layouts/harbormaster-sea.svg",
  "terminal_padding": [14, 12],
  "resizable": false,
  "children": [
    { "id": "hs-sea", "type": "block", "size": { "px": 220 }, "min": 160, "content": { "mod": "harbormaster", "props": { "role": "harbor" } } },
    { "id": "hs-rail", "type": "block", "size": { "px": 26 }, "content": { "mod": "harbormaster", "props": { "role": "harbor-rail" } } },
    { "id": "hs-deck", "type": "block", "size": { "weight": 1 }, "padding": 8,
      "content": { "tab": "active", "pane": {
        "header": { "content": { "mod": "pane" }, "reveal": "always", "height": 30, "position": "top" },
        "background": "background", "border": { "width": 1, "color": "border" }, "focus": { "width": 1, "color": "accent" },
        "radius": 10, "gap": 8, "lone": true } } }
  ]
}
