{
  "id": "rb-root",
  "type": "column",
  "preview": "layouts/runs-board.svg",
  "children": [
    { "id": "rb-summary", "type": "block", "size": { "px": 66 }, "content": { "mod": "runs", "props": { "role": "summary" } } },
    {
      "id": "rb-body",
      "type": "row",
      "divider": { "width": 1, "color": "border" },
      "children": [
        { "id": "rb-agents", "type": "block", "size": { "px": 250 }, "min": 160, "max": 420, "content": { "mod": "agents-runs" } },
        { "id": "rb-runs", "type": "block", "size": { "weight": 1 }, "min": 320, "content": { "mod": "runs" } },
        {
          "id": "rb-focus",
          "type": "column",
          "size": { "weight": 1.4 },
          "min": 320,
          "children": [
            { "id": "rb-focus-rail", "type": "block", "size": { "px": 32 }, "content": { "mod": "runs", "props": { "role": "focus-rail" } } },
            { "id": "rb-agent", "type": "block", "padding": 6, "background": "canvas", "content": { "agent": "focused" } }
          ]
        }
      ]
    }
  ]
}
