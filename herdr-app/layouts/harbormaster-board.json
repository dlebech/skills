{
  "id": "hb-root",
  "type": "column",
  "preview": "layouts/harbormaster-board.svg",
  "children": [
    { "id": "hb-summary", "type": "block", "size": { "px": 66 }, "content": { "mod": "harbormaster", "props": { "role": "summary" } } },
    {
      "id": "hb-body",
      "type": "row",
      "divider": { "width": 1, "color": "border" },
      "children": [
        {
          "id": "hb-side",
          "type": "column",
          "size": { "px": 250 }, "min": 160, "max": 420,
          "children": [
            { "id": "hb-crew", "type": "block", "size": { "weight": 0.7 }, "min": 90, "content": { "mod": "harbormaster", "props": { "role": "crew" } } },
            { "id": "hb-agents", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "agents" } }
          ]
        },
        { "id": "hb-runs", "type": "block", "size": { "weight": 1 }, "min": 320, "content": { "mod": "harbormaster" } },
        {
          "id": "hb-focus",
          "type": "column",
          "size": { "weight": 1.4 },
          "min": 320,
          "children": [
            { "id": "hb-focus-rail", "type": "block", "size": { "px": 32 }, "content": { "mod": "harbormaster", "props": { "role": "focus-rail" } } },
            { "id": "hb-agent", "type": "block", "padding": 6, "background": "canvas", "content": { "agent": "focused" } }
          ]
        }
      ]
    }
  ]
}
